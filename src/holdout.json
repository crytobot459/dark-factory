  {"name": "empty_title_raises", "steps": [["add", ""]], "expect_error": "ValueError"},
  {"name": "done_marks_item", "steps": [["add", "Task A"], ["done", 1]], "expect_done": true},
  {"name": "done_bad_id_raises", "steps": [["done", 999]], "expect_error": "KeyError"},
  {"name": "list_preserves_order", "steps": [["add", "One"], ["add", "Two"], ["add", "Three"]], "expect_titles": ["One", "Two", "Three"]}
